{
  "name": "@force/cloud-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local sync agent: serves the dashboard on 127.0.0.1 and writes real-device records to Firestore with the Firebase Admin SDK. Runs on the laptop only.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "check": "tsx src/main.ts --check",
    "grant-reader": "tsx src/grant-reader.ts",
    "token": "tsx src/token.ts"
  },
  "dependencies": {
    "@force/cloud": "*",
    "@force/contracts": "*",
    "@force/engine": "*",
    "firebase-admin": "14.5.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@force/simulator": "*",
    "firebase": "13.3.0"
  }
}

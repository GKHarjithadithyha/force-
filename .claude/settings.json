{
  "permissions": {
    "allow": [
      "Bash(npm run *)", "Bash(npm install*)", "Bash(npm ci*)", "Bash(npm test*)", "Bash(npm view *)", "Bash(npm ls*)",
      "Bash(npx tsc *)", "Bash(npx vitest *)", "Bash(npx prettier *)", "Bash(npx eslint *)", "Bash(npx playwright *)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)", "Bash(git worktree list*)", "Bash(git worktree add *)",
      "Bash(graphify *)", "Bash(codex exec -s read-only *)",
      "PowerShell(npm run *)", "PowerShell(npm install*)", "PowerShell(npm ci*)", "PowerShell(npm test*)",
      "PowerShell(npx tsc *)", "PowerShell(npx vitest *)", "PowerShell(npx prettier *)", "PowerShell(npx eslint *)", "PowerShell(npx playwright *)",
      "PowerShell(git status*)", "PowerShell(git diff*)", "PowerShell(git log*)", "PowerShell(graphify *)", "PowerShell(codex exec -s read-only *)"
    ],
    "ask": [
      "Bash(rm *)", "Bash(git clean*)", "Bash(git reset --hard*)", "Bash(git checkout -- *)", "Bash(git restore *)", "Bash(git push*)",
      "Bash(git branch -D *)", "Bash(git worktree remove*)", "Bash(git stash drop*)",
      "Bash(npm publish*)", "Bash(npm uninstall*)", "Bash(npm install -g*)", "Bash(npm i -g*)",
      "Bash(npx firebase-tools *)", "Bash(firebase *)", "Bash(vercel *)", "Bash(netlify *)", "Bash(wrangler *)", "Bash(gcloud *)",
      "Bash(setx *)", "Bash(reg *)", "Bash(codex exec -s workspace-write *)", "Bash(codex exec --full-auto*)", "Bash(codex login*)",
      "PowerShell(Remove-Item *)", "PowerShell(rm *)", "PowerShell(del *)", "PowerShell(git clean*)", "PowerShell(git reset --hard*)", "PowerShell(git push*)",
      "PowerShell(npm publish*)", "PowerShell(npm install -g*)", "PowerShell(npm i -g*)", "PowerShell(Set-ItemProperty *)", "PowerShell(New-ItemProperty *)",
      "PowerShell(setx *)", "PowerShell(firebase *)", "PowerShell(npx firebase-tools *)", "PowerShell(vercel *)",
      "Edit(**/.env.cloud)", "Edit(**/.env.local)", "Edit(**/secrets/**)", "Edit(**/*service-account*.json)",
      "Read(**/.env.cloud)", "Read(**/secrets/**)", "Read(**/*service-account*.json)"
    ],
    "deny": [
      "Read(~/.codex/auth.json)", "Read(~/.claude/.credentials.json)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
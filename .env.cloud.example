# F.O.R.C.E local sync agent (packages/cloud-agent). See FIREBASE_SETUP.md.
#
# 1. Copy this file to .env.cloud in the SAME folder (the repository root). .env.cloud is git-ignored.
# 2. Fill in the values below. Never paste a private key into this file or into any chat:
#    point GOOGLE_APPLICATION_CREDENTIALS at the downloaded JSON key file instead.
# These settings are used ONLY by the local agent process on this laptop, never by the browser.

# Firebase project id (Firebase Console > Project settings > General > Project ID). Not secret.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Full path to the service-account key file (Firebase Console > Project settings > Service accounts >
# Generate new private key). SECRET FILE: keep it outside the repository, e.g.
#   C:\Users\<you>\.force\firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\the\repo\firebase-service-account.json

# Firestore database id. Leave empty for the default database "(default)".
FIRESTORE_DATABASE_ID=

# Port of the agent on 127.0.0.1 (it never listens on the network). Default 8787.
FORCE_SYNC_PORT=8787

# Dashboard build served by the agent. Default fedfront/out; "off" serves the sync API only.
FORCE_SYNC_STATIC_DIR=

# Extra browser origins allowed to call the agent, comma separated. Only needed when the dashboard
# runs on `next dev`: http://localhost:3000
FORCE_SYNC_ALLOWED_ORIGINS=

# Optional installation site, stored on the device document. Set both or neither.
FORCE_SITE_ID=
FORCE_SITE_NAME=

# Development only: use the Firestore emulator instead of the real project (no key file needed).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

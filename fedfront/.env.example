# Copy to .env.local only if you need to change a default. See docs/ENVIRONMENT.md.
#
# NEXT_PUBLIC_ENGINE
#   (unset) or device  Real engine: Web Bluetooth + Web Worker + IndexedDB "force". Default.
#   mock               Simulated hardware on IndexedDB "force-mock". Development and tests only;
#                      `next build` refuses it unless FORCE_ALLOW_MOCK_BUILD=1.
NEXT_PUBLIC_ENGINE=

# FORCE_ALLOW_MOCK_BUILD=1   Allow a production build in mock mode (a labelled demo build only).

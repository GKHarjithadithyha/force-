# Copy to .env.local only if you need to change a default. See docs/ENVIRONMENT.md.
# Every NEXT_PUBLIC_ value is built into the public JavaScript: never put a secret here.
#
# NEXT_PUBLIC_ENGINE
#   (unset) or device  Real engine: Web Bluetooth + Web Worker + IndexedDB "force". Default.
#   mock               Simulated hardware on IndexedDB "force-mock". Development and tests only;
#                      `next build` refuses it unless FORCE_ALLOW_MOCK_BUILD=1.
NEXT_PUBLIC_ENGINE=

# FORCE_ALLOW_MOCK_BUILD=1   Allow a production build in mock mode (a labelled demo build only).

# NEXT_PUBLIC_CLOUD_SYNC_URL   Firestore cloud sync through the local sync agent (FIREBASE_SETUP.md).
#   (unset)                                  Cloud sync off. Default.
#   /api/sync/v1                             Dashboard served BY the agent (npm run cloud:agent).
#   http://127.0.0.1:8787/api/sync/v1        Dashboard on `next dev` (localhost:3000); also set
#                                            FORCE_SYNC_ALLOWED_ORIGINS=http://localhost:3000 in .env.cloud.
#   Not a secret: it only points at this computer. Mock mode never syncs.
NEXT_PUBLIC_CLOUD_SYNC_URL=
